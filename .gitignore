bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/
*.DotSettings.user

# Note: root appsettings*.json are tracked (non-secret config). Real secrets go
# in .NET User Secrets, never in appsettings — so they can't be committed here.
# The mobile head has no user-secrets store, so it bundles keys in its own
# appsettings.json — keep that one OUT of git.
MediaArchive.Mobile/appsettings.json

# Cached cover images (re-downloaded from the providers on import)
covers/

# SQLite database (created + seeded on first run)
*.db
*.db-shm
*.db-wal

# Rider HTTP client secrets
**/http-client.private.env.json

# JetBrains IDE config (editor-local, not project source)
.idea/
# Throwaway Xcode target used only to renew the iOS provisioning profile (see ./ma)
.provisioning/

# Local snapshots pulled off the phone by ./ma pull
backups/

# Widget extension build output (xcodebuild SYMROOT, see ./ma)
widget/build/
widget/xcodebuild.log
