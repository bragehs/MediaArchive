bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/
*.DotSettings.user

# Note: appsettings*.json are tracked (non-secret config). Real secrets go in
# .NET User Secrets, never in appsettings — so they can't be committed here.

# Cached cover images (re-downloaded from the providers on import)
covers/

# SQLite database (created + seeded on first run)
*.db
*.db-shm
*.db-wal

# Rider HTTP client secrets
**/http-client.private.env.json

# JetBrains IDE config (editor-local, not project source)
.idea/