<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>MediaArchive.Mobile</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>MediaArchive</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>no.norapps.mediaarchive</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Device runs iOS 18.3.2; keep the floor at or below that so it installs. -->
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>

        <!-- App Group shared with the widget extension. -->
        <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- The home-screen widget: a Swift .appex compiled by xcodebuild (see ./ma),
         embedded and co-signed here. The Exists() guard keeps plain `dotnet build`
         working before the widget has been compiled for the current flavor. -->
    <PropertyGroup>
        <_WidgetBuildOutput>build/Debug-iphoneos</_WidgetBuildOutput>
        <_WidgetBuildOutput Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.Contains('simulator'))">build/Debug-iphonesimulator</_WidgetBuildOutput>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\widget\$(_WidgetBuildOutput)\MediaArchiveWidget.appex')">
        <AdditionalAppExtensions Include="$(MSBuildThisFileDirectory)..\widget">
            <Name>MediaArchiveWidget</Name>
            <BuildOutput>$(_WidgetBuildOutput)</BuildOutput>
        </AdditionalAppExtensions>
        <!-- Swift shim exposing WidgetKit's reload call to C#
             (WidgetSnapshotPublisher) — WidgetKit itself has no .NET binding. -->
        <NativeReference Include="$(MSBuildThisFileDirectory)..\widget\$(_WidgetBuildOutput)\WidgetLink.framework">
            <Kind>Framework</Kind>
        </NativeReference>
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <!-- The in-app .brandmark, rendered by branding/makeicon.swift. Full-bleed
             and opaque, so iOS's own squircle mask does the rounding; single-image
             (no ForegroundFile) so the art is used exactly as drawn. -->
        <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0a0a0a" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0a0a0a" BaseSize="128,128" />

        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- Provider keys, loaded at startup via AddJsonStream. Gitignored. -->
        <MauiAsset Include="appsettings.json" LogicalName="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MediaArchive.csproj" />
    </ItemGroup>

</Project>
