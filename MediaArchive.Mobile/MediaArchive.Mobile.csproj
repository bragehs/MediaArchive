<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>MediaArchive.Mobile</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>MediaArchive</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>no.norapps.mediaarchive</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Device runs iOS 18.3.2; keep the floor at or below that so it installs. -->
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>

        <!-- App Group shared with the widget extension. -->
        <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- Two Swift products compiled by xcodebuild (see ./ma) and embedded here:
         the UI framework, which is the whole front end, and the home-screen
         widget .appex. Each is staged per SDK (.nativebuild/<sdk>,
         .widgetbuild/<sdk>) because the appex-embedding targets scan the whole
         extension directory for frameworks to promote — mixing flavors ships a
         wrong-platform framework and the app dies at launch on device. The
         Exists() guards keep plain `dotnet build` compiling before either is built. -->
    <PropertyGroup>
        <_NativeSdk>iphoneos</_NativeSdk>
        <_NativeSdk Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.Contains('simulator'))">iphonesimulator</_NativeSdk>
        <_NativeStage>$(MSBuildThisFileDirectory)..\.nativebuild\$(_NativeSdk)</_NativeStage>
        <_WidgetStage>$(MSBuildThisFileDirectory)..\.widgetbuild\$(_NativeSdk)</_WidgetStage>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_NativeStage)\Debug-$(_NativeSdk)\MediaArchiveUI.framework')">
        <!-- The Swift UI (native/), plus the MAWidgetLink shim WidgetSnapshotPublisher
             reaches through the ObjC runtime. -->
        <NativeReference Include="$(_NativeStage)\Debug-$(_NativeSdk)\MediaArchiveUI.framework">
            <Kind>Framework</Kind>
        </NativeReference>
        <!-- The Live Activity's pause intent runs in this process, and iOS only finds it
             through the app's own Metadata.appintents — which Xcode writes for the
             framework and the .NET build does not, so it is copied to the bundle root. -->
        <BundleResource Include="$(_NativeStage)\Debug-$(_NativeSdk)\MediaArchiveUI.framework\Metadata.appintents\*">
            <LogicalName>Metadata.appintents/%(Filename)%(Extension)</LogicalName>
        </BundleResource>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(_WidgetStage)\Debug-$(_NativeSdk)\MediaArchiveWidget.appex')">
        <AdditionalAppExtensions Include="$(_WidgetStage)">
            <Name>MediaArchiveWidget</Name>
            <BuildOutput>Debug-$(_NativeSdk)</BuildOutput>
            <!-- The .NET build re-signs the appex; without this it strips the
                 App Group entitlement and the widget can't read its snapshot. -->
            <CodesignEntitlements>$(MSBuildThisFileDirectory)..\widget\MediaArchiveWidget.entitlements</CodesignEntitlements>
        </AdditionalAppExtensions>
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <!-- The in-app .brandmark, rendered by branding/makeicon.swift. Full-bleed
             and opaque, so iOS's own squircle mask does the rounding; single-image
             (no ForegroundFile) so the art is used exactly as drawn. -->
        <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0a0a0a" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0a0a0a" BaseSize="128,128" />

        <!-- The theme's fonts and the masthead brandmark, read by the Swift UI from
             the main bundle. MauiFont so MAUI writes them into UIAppFonts for us. -->
        <MauiFont Include="Resources\Fonts\*.ttf" />
        <BundleResource Include="Resources\Images\brandmark.png" LogicalName="brandmark.png" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- Provider keys, loaded at startup via AddJsonStream. Gitignored. -->
        <MauiAsset Include="appsettings.json" LogicalName="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <!-- AddJsonStream for appsettings.json; used to ride in with the WebView package. -->
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MediaArchive.csproj" />
    </ItemGroup>

</Project>
