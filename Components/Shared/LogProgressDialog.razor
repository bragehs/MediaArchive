@using MediaArchive.Services
@inject LoggingService LogService

@* Blocking modal for an already-open pass: log progress (AddNote) or finish it
   (FinishPass). Invoked from Home's open-now rows. *@

<div class="modal-scrim" @onclick="Close">
    <div class="modal" @onclick:stopPropagation="true">
        <div class="cap-head">
            <span class="label">Log</span>
            <span class="cap-sel">@Title · @UiHelpers.TypeLabel(MediaType)</span>
        </div>

        <div class="cap-block">
            <div class="fl">What are you logging?</div>
            <div class="segs">
                <button class="seg @(_mode == Mode.Progress ? "on" : "")" @onclick="() => _mode = Mode.Progress">
                    Progress
                </button>
                <button class="seg @(_mode == Mode.Finish ? "on" : "")" @onclick="() => _mode = Mode.Finish">
                    Finish
                </button>
            </div>
        </div>

        @if (_mode == Mode.Progress)
        {
            <div class="cap-row">
                <div>
                    @if (Audiobook)
                    {
                        <div class="fl">Hours listened so far <b>required</b></div>
                        <input class="in" type="number" min="0" step="0.1" @bind="_progressHours"
                               placeholder="@(AudioHours?.ToString() ?? "")"/>
                    }
                    else
                    {
                        <div class="fl">Effort so far (@UiHelpers.LengthUnit(MediaType)) <b>required</b></div>
                        <input class="in" type="number" min="0" @bind="_progressEffort"/>
                    }
                </div>
            </div>
            <div class="cap-block">
                <div class="fl">Progress note <span class="opt">optional</span></div>
                <textarea class="area dim" @bind="_progressNote" @bind:event="oninput"
                          placeholder="Anything to say? (optional — the number is enough)"></textarea>
            </div>
        }
        else
        {
            <div class="cap-row">
                <div>
                    <div class="fl">End</div>
                    <input class="in" type="date" @bind="_endDate"/>
                </div>
                <div>
                    @if (Audiobook)
                    {
                        <div class="fl">Hours listened <span class="opt">optional</span></div>
                        <input class="in" type="number" min="0" step="0.1" @bind="_finishHours"
                               placeholder="@(AudioHours?.ToString() ?? "")"/>
                    }
                    else
                    {
                        <div class="fl">Effort (@UiHelpers.LengthUnit(MediaType)) <span class="opt">optional</span></div>
                        <input class="in" type="number" min="0" @bind="_finishEffort"/>
                    }
                </div>
            </div>

            <div class="cap-row">
                <div>
                    <div class="fl">Outcome</div>
                    <div class="segs">
                        <button class="seg @(!_dropped ? "on" : "")" @onclick="() => _dropped = false">Completed</button>
                        <button class="seg @(_dropped ? "on" : "")" @onclick="() => _dropped = true">Dropped</button>
                    </div>
                </div>
                @if (!_dropped)
                {
                    <div>
                        <div class="fl">Rating</div>
                        <div class="stars">
                            <span class="track">★★★★★</span>
                            <span class="fill" style="width:@(_rating * 10)%">★★★★★</span>
                            @for (var half = 1; half <= 10; half++)
                            {
                                var value = half;
                                <button class="hit" style="left:@((half - 1) * 10)%"
                                        title="@(value / 2.0)" @onclick="() => _rating = value"></button>
                            }
                        </div>
                        @if (_rating > 0)
                        {
                            <button class="starclear" @onclick="() => _rating = 0">clear</button>
                        }
                    </div>
                }
            </div>

            <div class="cap-block">
                <div class="fl">@(_dropped ? "Why you dropped it" : "Finish note") <span class="opt">optional</span></div>
                <textarea class="area dim" @bind="_finishNote" @bind:event="oninput"
                          placeholder="How it landed — this is what the Diary shows."></textarea>
            </div>
        }

        @if (_error is not null)
        {
            <div class="notice bad">@_error</div>
        }

        <div class="cap-foot">
            <span class="req"></span>
            <button class="btn ghost" @onclick="Close">Cancel</button>
            <button class="btn" @onclick="Submit" disabled="@(_saving || !CanSubmit)">
                @(_saving ? "…" : _mode == Mode.Progress ? "Save progress" : "Finish it")
            </button>
        </div>
    </div>
</div>

@code {
    private enum Mode { Progress, Finish }

    // Takes the open pass by id rather than a whole row DTO, so both the home
    // page and the item detail modal can open it.
    [Parameter, EditorRequired] public int EntryId { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public MediaType MediaType { get; set; }
    // Audiobook: effort is entered in hours and converted to pages before saving.
    [Parameter] public bool Audiobook { get; set; }
    [Parameter] public double? AudioHours { get; set; }
    [Parameter] public int? PageCount { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnLogged { get; set; }

    private Mode _mode = Mode.Progress;

    private int? _progressEffort;
    private double? _progressHours;
    private string _progressNote = "";

    private DateOnly? _endDate = DateOnly.FromDateTime(DateTime.Today);
    private int? _finishEffort;
    private double? _finishHours;
    private int _rating;
    private string _finishNote = "";
    private bool _dropped;

    private bool _saving;
    private string? _error;

    private bool CanSubmit => _mode switch
    {
        // Progress logs a data point for stats; the number is required, the note isn't.
        Mode.Progress => Audiobook ? _progressHours is > 0 : _progressEffort is > 0,
        _ => _endDate is not null
    };

    // Audiobook hours → canonical pages; falls through to the plain page effort.
    private int? ToPages(double? hours) => Book.PagesFromHours(hours, AudioHours, PageCount);

    private async Task Submit()
    {
        _saving = true;
        _error = null;

        try
        {
            if (_mode == Mode.Progress)
            {
                var effort = Audiobook ? ToPages(_progressHours) : _progressEffort;
                await LogService.AddNoteAsync(EntryId,
                    new NoteInput(_progressNote.Trim(), effort));
            }
            else
            {
                var note = _finishNote.Trim().Length == 0 ? null : _finishNote.Trim();
                var effort = Audiobook ? ToPages(_finishHours) : _finishEffort;
                await LogService.FinishPassAsync(EntryId,
                    new PassFinish(_endDate!.Value, _rating == 0 ? null : _rating,
                        effort, note, _dropped));
            }

            await OnLogged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _saving = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
