@using MediaArchive.Services
@inject LibraryQueries Library
@inject NavigationManager Nav

@* Masthead search over YOUR archive (title or creator). Adding new items lives in
   Explore now — this bar only finds what you already have and jumps to it. *@

<div class="gsearch">
    <input class="gsearch-input" placeholder="Search your archive…"
           value="@_query" @oninput="OnInput" @onfocus="() => _open = true" @onkeydown="OnKey"/>
    @if (_open)
    {
        <button class="gsearch-esc" @onclick="Close">esc</button>
    }

    @if (_open && _query.Trim().Length > 0)
    {
        <div class="searchpanel">
            @if (_results.Count > 0)
            {
                <div class="label colhead">@_results.Count in your archive</div>
                @foreach (var result in _results)
                {
                    <button class="result" @onclick="() => Open(result)">
                        @if (result.ImageUrl is { } cover)
                        {
                            <img class="rcov" src="@cover" alt="" loading="lazy"/>
                        }
                        else
                        {
                            <div class="rcov rcov-none"></div>
                        }
                        <div class="rmeta">
                            <div class="rt2">@result.Title</div>
                            <div class="ra">
                                @UiHelpers.TypeLabel(result.MediaType)@(result.Creator is null ? "" : " · " + result.Creator)
                            </div>
                        </div>
                        <div class="rstatus @UiHelpers.StatusClass(result.Status)" title="@UiHelpers.StatusLabel(result.Status)">
                            @UiHelpers.StatusGlyph(result.Status)
                        </div>
                    </button>
                }
            }
            else
            {
                <p class="muted">No matches in your archive for “@_query”.</p>
            }
        </div>
    }
</div>

@code {
    private string _query = "";
    private bool _open;
    private IReadOnlyList<LibrarySearchResult> _results = [];

    private async Task OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _results = await Library.SearchLibraryAsync(_query);
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private void Open(LibrarySearchResult result)
    {
        Close();
        Nav.NavigateTo($"/item/{result.UserMediaItemId}");
    }

    private void Close() => _open = false;
}
