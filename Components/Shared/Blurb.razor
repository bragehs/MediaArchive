@inject IJSRuntime JS

<div class="blurb @(_open ? "open" : "")" @ref="_element">@Text</div>
@if (_overflows)
{
    <button class="more" @onclick="() => _open = !_open">@(_open ? "show less" : "show more")</button>
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    private ElementReference _element;
    private bool _open;
    private bool _overflows;

    // Null until the current Text has been measured; item→item reuses this instance.
    private string? _measured;

    protected override void OnParametersSet()
    {
        if (_measured == Text)
            return;

        _measured = null;
        _open = false;
        _overflows = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_measured == Text)
            return;

        _measured = Text;

        if (await JS.InvokeAsync<bool>("blurb.overflows", _element))
        {
            _overflows = true;
            StateHasChanged();
        }
    }
}
