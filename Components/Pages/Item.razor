@page "/item/{UserMediaItemId:int}"
@using MediaArchive.Services
@inject CollectionService Collection
@inject ConsumptionService Consumption
@inject MediaImportService ImportService

@* The universal item view. Reached by clicking any cover in the app.
   Left: the work. Middle: my classification of it. Right: the pass log. *@

<PageTitle>@(_item?.Title ?? "Item") · MediaArchive</PageTitle>

@if (_item is null)
{
    <p class="hint">@(_loading ? "Loading…" : "Item not found.")</p>
}
else
{
    var item = _item;

    <div class="itemhead">
        <a class="backlink" href="/">← Back</a>
        <span class="idtype" style="color:@UiHelpers.TypeColorVar(item.MediaType)">
            @UiHelpers.TypeLabel(item.MediaType)
        </span>
        <span class="idstatus @UiHelpers.StatusClass(item.Status)">
            @UiHelpers.StatusGlyph(item.Status) @UiHelpers.StatusLabel(item.Status)
        </span>
        <button class="idfav @(item.IsFavorite ? "on" : "")" title="Favourite" @onclick="ToggleFavorite">
            @(item.IsFavorite ? "★" : "☆")
        </button>
    </div>

    <h1 class="itemtitle">@item.Title</h1>
    @if (!string.IsNullOrWhiteSpace(item.Creator))
    {
        <div class="idcreator">@item.Creator</div>
    }

    <div class="itemgrid">

      @* the work and the diary share the left track, so the diary's rule sits
         directly under the description rather than under the taller aside *@
      <div class="itemmain">
        <div class="workrow">

        @* ── left: the cover ── *@
        <div class="itemcol">
            <div class="idcover">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="Cover of @item.Title"/>
                }
                else
                {
                    <div class="fb"><span>@item.Title</span></div>
                }
            </div>
        </div>

        @* ── middle: the basics ── *@
        <div class="itemcol">
            <div class="idrating">
                <div class="stars">
                    <span class="track">★★★★★</span>
                    <span class="fill" style="width:@((item.Rating ?? 0) * 10)%">★★★★★</span>
                    @for (var half = 1; half <= 10; half++)
                    {
                        var value = half;
                        <button class="hit" style="left:@((half - 1) * 10)%"
                                title="@(value / 2.0)" @onclick="() => SetRating(value)"></button>
                    }
                </div>
                @if (item.Rating is { } r)
                {
                    <span class="idratingn">@(r / 2.0)</span>
                    <button class="starclear" @onclick="() => SetRating(null)">clear</button>
                }
            </div>

            <div class="dfacts">
                @if (item.ReleaseDate is { } released)
                {
                    <div class="dfact"><div class="n">@released.Year</div><div class="l">Released</div></div>
                }
                @if (item.Length is { } length)
                {
                    <div class="dfact">
                        <div class="n">@length</div>
                        <div class="l">@UiHelpers.LengthUnit(item.MediaType)</div>
                    </div>
                }
                @if (item.ExternalRating is { } ext)
                {
                    <div class="dfact">
                        <div class="n">@ext.ToString("0.0")</div>
                        <div class="l">Public @(item.ExternalRatingCount is { } c ? $"({c:N0})" : "")</div>
                    </div>
                }
                <div class="dfact">
                    <div class="n sm">@item.AddedDate.ToString("d MMM yyyy")</div>
                    <div class="l">Added</div>
                </div>
                @if (item.Discovery is { } discovery)
                {
                    <div class="dfact">
                        <div class="n sm">@UiHelpers.DiscoveryLabel(discovery)</div>
                        <div class="l">Found via</div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(item.Description))
            {
                <div class="iddesc">@item.Description</div>
            }
        </div>

        </div>

        @* ── below the description: the diary ── *@
        <div class="itemdiary">
            <div class="cap-head">
                <span class="label">Passes</span>
                <span class="cap-sel">@_history.Count</span>
            </div>

            @if (_history.Count == 0)
            {
                <p class="homeempty">No passes yet.</p>
            }
            else
            {
                <div class="passgrid">
                    @foreach (var pass in _history)
                    {
                        <div class="idpass">
                            <div class="idpasshead">
                                <b>@(pass.StartDate?.ToString("d MMM yyyy") ?? "—")</b>
                                @if (pass.EndDate is { } end)
                                {
                                    <span>→ @end.ToString("d MMM yyyy")</span>
                                    <span class="idoutcome">@(pass.Outcome == PassOutcome.Dropped ? "dropped" : "completed")</span>
                                }
                                else
                                {
                                    <span class="idoutcome open">open</span>
                                }
                                @if (pass.Context is { } context)
                                {
                                    <span class="idctx">@UiHelpers.ContextLabel(context)</span>
                                }
                            </div>

                            @if (pass.RatingAtTime is { } rated)
                            {
                                <div class="idpassrating">rated @(rated / 2.0)</div>
                            }

                            @foreach (var note in pass.Notes.Where(n => !string.IsNullOrWhiteSpace(n.Text)))
                            {
                                <div class="idnote">
                                    <span class="idnotekind">@note.Kind.ToString().ToLowerInvariant()</span>
                                    @note.Text
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
      </div>

        @* ── right: my classification of it ── *@
        <div class="itemcol">
            <div class="idaction">
                @if (item.OpenPass is { } open)
                {
                    <div class="idprogress">
                        <div class="fl">
                            In progress since @(open.StartDate?.ToString("d MMM") ?? "—")
                            @if (open.Effort is { } effort)
                            {
                                <span class="opt">
                                    · @effort @UiHelpers.LengthUnit(item.MediaType)@(open.Progress is { } p ? $" ({p:0}%)" : "")
                                </span>
                            }
                        </div>
                        @if (open.Progress is { } pct)
                        {
                            <div class="oprog"><i style="width:@(Math.Min(pct, 100).ToString("0"))%"></i></div>
                        }
                    </div>
                    <button class="btn" @onclick="() => _logging = true">Log progress →</button>
                }
                else if (_startingPass)
                {
                    <div class="idstart">
                        <div class="cap-row">
                            <div>
                                <div class="fl">Start date</div>
                                <input class="in" type="date" @bind="_startDate"/>
                            </div>
                            <div>
                                <div class="fl">How <span class="opt">optional</span></div>
                                <select class="in" @bind="_startContext">
                                    <option value="">—</option>
                                    @foreach (var context in UiHelpers.ContextsFor(item.MediaType))
                                    {
                                        <option value="@context">@UiHelpers.ContextLabel(context)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="cap-block">
                            <div class="fl">Opening note <span class="opt">optional</span></div>
                            <textarea class="area" @bind="_startNote" @bind:event="oninput"
                                      placeholder="Why now, what you expect…"></textarea>
                        </div>
                        <div class="cap-foot">
                            <span class="req"></span>
                            <button class="btn ghost" @onclick="() => _startingPass = false">Cancel</button>
                            <button class="btn" @onclick="StartPass" disabled="@_saving">
                                @(_saving ? "…" : "Open the pass")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn" @onclick="() => _startingPass = true">
                        @(item.PassCount == 0 ? "Start a pass" : "Start a new pass")
                    </button>
                }
            </div>

            <div class="cap-head">
                <span class="label">Classification</span>
                @if (_dirty)
                {
                    <span class="cap-sel">unsaved</span>
                }
            </div>

            <div class="cap-block">
                <div class="fl">Genres</div>
                <VocabularyPicker Selected="_genres" SelectedChanged="OnVocabularyChanged"
                                  Suggestions="_vocabulary.Genres" Placeholder="Fantasy, Noir…"/>
            </div>

            <div class="cap-block">
                <div class="fl">Tags</div>
                <VocabularyPicker Selected="_tags" SelectedChanged="OnVocabularyChanged"
                                  Suggestions="_vocabulary.Tags" Placeholder="melancholy, slow burn…"/>
            </div>

            <div class="cap-block">
                <div class="fl">Series</div>
                <VocabularyPicker Selected="_series" SelectedChanged="OnVocabularyChanged"
                                  Suggestions="_vocabulary.Series" Max="1" Placeholder="Mistborn Era 1…"/>
            </div>

            <div class="cap-row">
                <div>
                    <div class="fl">Position <span class="opt">optional</span></div>
                    <input class="in" type="number" min="1" @bind="_seriesPosition"
                           @bind:after="MarkDirty" disabled="@(_series.Count == 0)"/>
                </div>
            </div>

            <div class="cap-block">
                <div class="fl">Universe</div>
                <VocabularyPicker Selected="_universe" SelectedChanged="OnVocabularyChanged"
                                  Suggestions="_vocabulary.Universes" Max="1" Placeholder="Cosmere…"/>
            </div>

            @if (_error is not null)
            {
                <div class="notice bad">@_error</div>
            }

            <div class="cap-foot">
                <span class="req"></span>
                <button class="btn" @onclick="SaveDetails" disabled="@(_saving || !_dirty)">
                    @(_saving ? "…" : "Save classification")
                </button>
            </div>
        </div>

    </div>
}

@if (_logging && _item?.OpenPass is { } openPass)
{
    <LogProgressDialog EntryId="@openPass.EntryId" Title="@_item.Title" MediaType="@_item.MediaType"
                       OnClose="() => _logging = false" OnLogged="OnPassLogged"/>
}

@code {
    [Parameter] public int UserMediaItemId { get; set; }

    private ItemDetail? _item;
    private List<PassSummary> _history = [];
    private Vocabulary _vocabulary = new([], [], [], []);

    private List<string> _genres = [];
    private List<string> _tags = [];
    private List<string> _series = [];
    private List<string> _universe = [];
    private int? _seriesPosition;

    private bool _loading = true;
    private bool _saving;
    private bool _dirty;
    private string? _error;

    private bool _logging;
    private bool _startingPass;
    private DateOnly? _startDate = DateOnly.FromDateTime(DateTime.Today);
    private string _startContext = "";
    private string _startNote = "";

    // The classification (facet/appliesTo) of tags the item already had, so
    // re-saving doesn't strip it. Tags created here start unclassified.
    private Dictionary<string, TagInput> _knownTags = new(StringComparer.OrdinalIgnoreCase);

    // Runs again when the route parameter changes — navigating item→item reuses
    // this component instance rather than building a new one.
    protected override async Task OnParametersSetAsync()
    {
        _vocabulary = await ImportService.GetVocabularyAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _item = await Collection.GetItemDetailAsync(UserMediaItemId);

        if (_item is not null)
        {
            _genres = [.._item.Genres];
            _tags = _item.Tags.Select(t => t.Name).ToList();
            _knownTags = _item.Tags.ToDictionary(t => t.Name, StringComparer.OrdinalIgnoreCase);
            _series = _item.Series is { } s ? [s] : [];
            _universe = _item.Universe is { } u ? [u] : [];
            _seriesPosition = _item.SeriesPosition;

            _history = _item.PassCount > 0
                ? await Consumption.GetPassHistoryAsync(UserMediaItemId)
                : [];
        }

        _dirty = false;
        _loading = false;
    }

    private Task OnVocabularyChanged(List<string> _) => MarkDirty();

    private Task MarkDirty()
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private async Task SaveDetails()
    {
        if (_item is null) return;

        _saving = true;
        _error = null;

        try
        {
            var tags = _tags
                .Select(name => _knownTags.TryGetValue(name, out var known)
                    ? known
                    : new TagInput(name, null, null))
                .ToList();

            await Collection.UpdateDetailsAsync(_item.MediaItemId, new WorkDetails(
                _genres, tags,
                _universe.FirstOrDefault(), _series.FirstOrDefault(),
                _series.Count > 0 ? _seriesPosition : null,
                null));

            _vocabulary = await ImportService.GetVocabularyAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SetRating(int? rating)
    {
        if (_item is null) return;

        await Collection.SetRatingAsync(_item.UserMediaItemId, rating);
        _item = _item with { Rating = rating };
    }

    private async Task ToggleFavorite()
    {
        if (_item is null) return;

        var next = !_item.IsFavorite;
        await Collection.SetFavoriteAsync(_item.UserMediaItemId, next);
        _item = _item with { IsFavorite = next };
    }

    private async Task StartPass()
    {
        if (_item is null) return;

        _saving = true;
        _error = null;

        try
        {
            var context = Enum.TryParse<ConsumptionContext>(_startContext, out var parsed)
                ? parsed
                : (ConsumptionContext?)null;

            await Consumption.StartPassAsync(_item.UserMediaItemId,
                new PassStart(_startDate, context,
                    _startNote.Trim().Length == 0 ? null : _startNote));

            _startingPass = false;
            _startNote = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnPassLogged()
    {
        _logging = false;
        await LoadAsync();
    }
}
