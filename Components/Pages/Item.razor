@page "/item/{UserMediaItemId:int}"
@using MediaArchive.Services
@inject CommonQueries Common
@inject MediaImportService ImportService
@inject LoggingService Logging
@inject UserItemService UserItems

@* The record for one logged item: the work, my classification, the pass log. *@

<PageTitle>@(_item?.Title ?? "Item") · MediaArchive</PageTitle>

@if (_item is null)
{
    <p class="iempty">@(_loading ? "Loading…" : "Item not found.")</p>
}
else
{
    var item = _item;

    <div class="itopnav">
        <a class="iback" href="/">‹ Back</a>
        <button class="ifav @(item.IsFavorite ? "on" : "")" @onclick="ToggleFavorite">
            @(item.IsFavorite ? "♥" : "♡")
        </button>
    </div>

    <div class="ihero">
        <div class="icov" style="--t:@UiHelpers.TypeColorVar(item.MediaType)">
            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
            {
                <img src="@item.ImageUrl" alt="Cover of @item.Title"/>
            }
            else
            {
                <span class="ifb">@item.Title</span>
            }
        </div>
        <div class="iherometa">
            <div class="ititle">@item.Title</div>
            @if (!string.IsNullOrWhiteSpace(item.Creator))
            {
                <div class="icreator">@item.Creator</div>
            }
            <div class="ibadge" style="color:@UiHelpers.TypeColorVar(item.MediaType)">
                @UiHelpers.TypeLabel(item.MediaType) · @UiHelpers.StatusGlyph(item.Status) @UiHelpers.StatusLabel(item.Status)
            </div>

            <div class="istars">
                <span class="istrack">★★★★★</span>
                <span class="isfill" style="width:@((item.Rating ?? 0) * 10)%">★★★★★</span>
                @for (var half = 1; half <= 10; half++)
                {
                    var value = half;
                    <button class="ihit" style="left:@((half - 1) * 10)%"
                            title="@(value / 2.0)" @onclick="() => SetRating(value)"></button>
                }
            </div>
            @if (item.Rating is { } r)
            {
                <button class="istarclear" @onclick="() => SetRating(null)">@(r / 2.0) — clear</button>
            }
        </div>
    </div>

    <div class="ifacts">
        @if (item.ReleaseDate is { } released)
        {
            <div class="ifact"><div class="ifn">@released.Year</div><div class="ifl">Released</div></div>
        }
        @if (item.Length is { } length)
        {
            <div class="ifact"><div class="ifn">@length</div><div class="ifl">@UiHelpers.LengthUnit(item.MediaType)</div></div>
        }
        @if (item.ExternalRating is { } ext)
        {
            <div class="ifact">
                <div class="ifn">@ext.ToString("0.0")</div>
                <div class="ifl">Public@(item.ExternalRatingCount is { } c ? $" · {c:N0}" : "")</div>
            </div>
        }
        <div class="ifact">
            <div class="ifn sm">@item.AddedDate.ToString("d MMM yyyy")</div>
            <div class="ifl">Added</div>
        </div>
    </div>

    @* ── action: continue an open pass, or start one ── *@
    @if (item.OpenPass is { } open)
    {
        <div class="iopen">
            In progress since @(open.StartDate?.ToString("d MMM") ?? "—")
            @if (open.Effort is { } effort)
            {
                <span>· @effort @UiHelpers.LengthUnit(item.MediaType)@(open.Progress is { } p ? $" ({p:0}%)" : "")</span>
            }
        </div>
        @if (open.Progress is { } pct)
        {
            <div class="ibar"><i style="width:@(Math.Min(pct, 100).ToString("0"))%"></i></div>
        }
        <button class="ibtn" @onclick="() => _logging = true">Log progress →</button>
    }
    else if (_startingPass)
    {
        <div class="istart">
            <div class="irow">
                <div>
                    <div class="il2">Start date</div>
                    <input class="iin" type="date" @bind="_startDate"/>
                </div>
                <div>
                    <div class="il2">How <span class="iopt">optional</span></div>
                    <select class="iin" @bind="_startContext">
                        <option value="">—</option>
                        @foreach (var context in UiHelpers.ContextsFor(item.MediaType))
                        {
                            <option value="@context">@UiHelpers.ContextLabel(context)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="il2">Opening note <span class="iopt">optional</span></div>
            <textarea class="iarea" @bind="_startNote" @bind:event="oninput"
                      placeholder="Why now, what you expect…"></textarea>
            <div class="istartfoot">
                <button class="ibtn ighost" @onclick="() => _startingPass = false">Cancel</button>
                <button class="ibtn" @onclick="StartPass" disabled="@_saving">
                    @(_saving ? "…" : "Open the pass")
                </button>
            </div>
        </div>
    }
    else
    {
        <button class="ibtn" @onclick="() => _startingPass = true">
            @(item.PassCount == 0 ? "Start a pass" : "Start a new pass")
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(item.Description))
    {
        <div class="idesc">@item.Description</div>
    }

    @* ── classification ── *@
    <div class="isec">
        <span class="ik">Classification</span>
        @if (_dirty)
        {
            <span class="ir">unsaved</span>
        }
    </div>

    <div class="ifield">
        <div class="il2">Genres</div>
        <VocabularyPicker Selected="_genres" SelectedChanged="OnVocabularyChanged"
                          Suggestions="_vocabulary.Genres" Placeholder="Fantasy, Noir…"/>
    </div>
    <div class="ifield">
        <div class="il2">Tags</div>
        <VocabularyPicker Selected="_tags" SelectedChanged="OnVocabularyChanged"
                          Suggestions="_vocabulary.Tags" Placeholder="melancholy, slow burn…"/>
    </div>
    <div class="ifield">
        <div class="il2">Series</div>
        <VocabularyPicker Selected="_series" SelectedChanged="OnVocabularyChanged"
                          Suggestions="_vocabulary.Series" Max="1" Placeholder="Mistborn Era 1…"/>
    </div>
    @if (_series.Count > 0)
    {
        <div class="ifield">
            <div class="il2">Position <span class="iopt">optional</span></div>
            <input class="iin" type="number" min="1" @bind="_seriesPosition" @bind:after="MarkDirty"/>
        </div>
    }
    <div class="ifield">
        <div class="il2">Universe</div>
        <VocabularyPicker Selected="_universe" SelectedChanged="OnVocabularyChanged"
                          Suggestions="_vocabulary.Universes" Max="1" Placeholder="Cosmere…"/>
    </div>

    @if (_error is not null)
    {
        <div class="inote bad">@_error</div>
    }

    <button class="ibtn ighost isave" @onclick="SaveDetails" disabled="@(_saving || !_dirty)">
        @(_saving ? "…" : "Save classification")
    </button>

    @* ── the pass log ── *@
    <div class="isec">
        <span class="ik">Passes</span>
        <span class="ir">@_history.Count total</span>
    </div>

    @if (_history.Count == 0)
    {
        <p class="iempty">No passes yet.</p>
    }
    else
    {
        @foreach (var pass in _history)
        {
            <div class="ipass">
                <div class="ipasshead">
                    <span class="ipstatus @PassClass(pass)">@PassLabel(pass)</span>
                    <span class="ipmeta">
                        @(pass.StartDate?.ToString("d MMM yyyy") ?? "—")@(pass.EndDate is { } end ? " → " + end.ToString("d MMM yyyy") : "")@(pass.Context is { } ctx ? " · " + UiHelpers.ContextLabel(ctx) : "")
                    </span>
                </div>
                @if (pass.RatingAtTime is { } rated)
                {
                    <div class="iprating">★ @(rated / 2.0)</div>
                }
                @foreach (var note in pass.Notes.Where(n => !string.IsNullOrWhiteSpace(n.Text)))
                {
                    <div class="ipnote">
                        <span class="ipkind">@note.Kind.ToString().ToLowerInvariant()</span>
                        @note.Text
                    </div>
                }
            </div>
        }
    }
}

@if (_logging && _item?.OpenPass is { } openPass)
{
    <LogProgressDialog EntryId="@openPass.EntryId" Title="@_item.Title" MediaType="@_item.MediaType"
                       OnClose="() => _logging = false" OnLogged="OnPassLogged"/>
}

@code {
    [Parameter] public int UserMediaItemId { get; set; }

    private ItemDetail? _item;
    private List<PassSummary> _history = [];
    private Vocabulary _vocabulary = new([], [], [], []);

    private List<string> _genres = [];
    private List<string> _tags = [];
    private List<string> _series = [];
    private List<string> _universe = [];
    private int? _seriesPosition;

    private bool _loading = true;
    private bool _saving;
    private bool _dirty;
    private string? _error;

    private bool _logging;
    private bool _startingPass;
    private DateOnly? _startDate = DateOnly.FromDateTime(DateTime.Today);
    private string _startContext = "";
    private string _startNote = "";

    // The classification (facet/appliesTo) of tags the item already had, so
    // re-saving doesn't strip it. Tags created here start unclassified.
    private Dictionary<string, TagInput> _knownTags = new(StringComparer.OrdinalIgnoreCase);

    // Runs again when the route parameter changes — navigating item→item reuses
    // this component instance rather than building a new one.
    protected override async Task OnParametersSetAsync()
    {
        _vocabulary = await ImportService.GetVocabularyAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _item = await Common.GetItemDetailAsync(UserMediaItemId);

        if (_item is not null)
        {
            _genres = [.._item.Genres];
            _tags = _item.Tags.Select(t => t.Name).ToList();
            _knownTags = _item.Tags.ToDictionary(t => t.Name, StringComparer.OrdinalIgnoreCase);
            _series = _item.Series is { } s ? [s] : [];
            _universe = _item.Universe is { } u ? [u] : [];
            _seriesPosition = _item.SeriesPosition;

            _history = _item.PassCount > 0
                ? await Common.GetPassHistoryAsync(UserMediaItemId)
                : [];
        }

        _dirty = false;
        _loading = false;
    }

    private Task OnVocabularyChanged(List<string> _) => MarkDirty();

    private Task MarkDirty()
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private async Task SaveDetails()
    {
        if (_item is null) return;

        _saving = true;
        _error = null;

        try
        {
            var tags = _tags
                .Select(name => _knownTags.TryGetValue(name, out var known)
                    ? known
                    : new TagInput(name, null, null))
                .ToList();

            await UserItems.UpdateDetailsAsync(_item.MediaItemId, new WorkDetails(
                _genres, tags,
                _universe.FirstOrDefault(), _series.FirstOrDefault(),
                _series.Count > 0 ? _seriesPosition : null,
                null));

            _vocabulary = await ImportService.GetVocabularyAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SetRating(int? rating)
    {
        if (_item is null) return;

        await UserItems.SetRatingAsync(_item.UserMediaItemId, rating);
        _item = _item with { Rating = rating };
    }

    private async Task ToggleFavorite()
    {
        if (_item is null) return;

        var next = !_item.IsFavorite;
        await UserItems.SetFavoriteAsync(_item.UserMediaItemId, next);
        _item = _item with { IsFavorite = next };
    }

    private async Task StartPass()
    {
        if (_item is null) return;

        _saving = true;
        _error = null;

        try
        {
            var context = Enum.TryParse<ConsumptionContext>(_startContext, out var parsed)
                ? parsed
                : (ConsumptionContext?)null;

            await Logging.StartPassAsync(_item.UserMediaItemId,
                new PassStart(_startDate, context,
                    _startNote.Trim().Length == 0 ? null : _startNote));

            _startingPass = false;
            _startNote = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnPassLogged()
    {
        _logging = false;
        await LoadAsync();
    }

    private static string PassLabel(PassSummary pass) =>
        pass.EndDate is null ? "▐▐ In progress"
        : pass.Outcome == PassOutcome.Dropped ? "✕ Dropped"
        : "✓ Completed";

    private static string PassClass(PassSummary pass) =>
        pass.EndDate is null ? "prog"
        : pass.Outcome == PassOutcome.Dropped ? "dro"
        : "fin";
}
