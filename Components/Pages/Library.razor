@page "/library"
@rendermode InteractiveServer
@inject LibraryService Lib

<PageTitle>Library · MediaArchive</PageTitle>

<div class="page-head">
    <h1>Library</h1>
    <p>One unified collection. Status, type &amp; genre are filters — not tabs.</p>
</div>

@if (_all is null)
{
    <div class="empty">Loading…</div>
}
else
{
    <div class="filter-row">
        <button class="chip @(_status is null ? "active" : "")" @onclick="() => SetStatus(null)">
            All <span class="count">@_all.Count</span>
        </button>
        @foreach (var s in _statuses)
        {
            <button class="chip @(_status == s ? "active" : "")" @onclick="() => SetStatus(s)">
                @UiHelpers.StatusGlyph(s) @UiHelpers.StatusLabel(s)
                <span class="count">@_all.Count(u => u.Status == s)</span>
            </button>
        }
    </div>
    <div class="filter-row">
        <button class="chip @(_type is null ? "active" : "")" @onclick="() => SetType(null)">All types</button>
        @foreach (var t in _types)
        {
            <button class="chip @(_type == t ? "active" : "")" @onclick="() => SetType(t)">
                @UiHelpers.TypeLabel(t)
                <span class="count">@_all.Count(u => u.MediaItem!.MediaType == t)</span>
            </button>
        }
    </div>

    var shown = Filtered().ToList();
    <div class="section-title">@shown.Count item@(shown.Count == 1 ? "" : "s")</div>
    @if (shown.Count == 0)
    {
        <div class="empty">Nothing matches these filters.</div>
    }
    else
    {
        <div class="wall">
            @foreach (var umi in shown)
            {
                <MediaCard Umi="umi" />
            }
        </div>
    }
}

@code {
    private List<UserMediaItem>? _all;
    private MediaStatus? _status;
    private MediaType? _type;

    private readonly MediaStatus[] _statuses =
        [MediaStatus.Interested, MediaStatus.InProgress, MediaStatus.Completed, MediaStatus.Dropped];
    private readonly MediaType[] _types =
        [MediaType.Book, MediaType.Game, MediaType.Movie, MediaType.Show, MediaType.Anime];

    protected override async Task OnInitializedAsync() => _all = await Lib.GetLibraryAsync();

    private IEnumerable<UserMediaItem> Filtered() => _all!
        .Where(u => _status is null || u.Status == _status)
        .Where(u => _type is null || u.MediaItem!.MediaType == _type);

    private void SetStatus(MediaStatus? s) => _status = s;
    private void SetType(MediaType? t) => _type = t;
}
