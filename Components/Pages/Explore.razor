@page "/explore"
@rendermode InteractiveServer
@using MediaArchive.Services
@using MediaArchive.Services.Providers
@inject MediaSearchService Search
@inject MediaImportService ImportService
@inject ConsumptionService LogService

<PageTitle>Explore · MediaArchive</PageTitle>

<div class="eyebrow label">Explore</div>
<div class="h-lg">Find your next thing.</div>
<div class="sub">Search any provider to add something new, or pick from what your taste suggests —
    everything here is not yet in your archive.</div>

@* ── ADD: search external providers; results float over the page, capture is a modal ── *@
<section class="homesec">
    <div class="sechead"><span class="label">Add anything</span><span class="rt">Search a provider</span></div>

    <div class="explore-search">
        <div class="searchbar">
            <input class="bigsearch" placeholder="Title or author, pick a type, hit Enter…"
                   @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKey"/>
            <div class="segs">
                @foreach (var type in Enum.GetValues<MediaType>())
                {
                    <button class="seg @(type == _mediaType ? "on" : "")" @onclick="() => SetType(type)">
                        @UiHelpers.TypeLabel(type)
                    </button>
                }
            </div>
        </div>

        @* results drop over the recommendations below rather than pushing them down *@
        @if (_selected is null && (_searching || _searched))
        {
            <div class="searchpanel">
                @if (_error is not null)
                {
                    <div class="notice bad">@_error</div>
                }
                @if (_searching)
                {
                    <p class="hint">Searching…</p>
                }
                else if (_results.Count > 0)
                {
                    <div class="label colhead">@_results.Count result@(_results.Count == 1 ? "" : "s")</div>
                    @foreach (var result in _results)
                    {
                        <button class="result" @onclick="() => Select(result)">
                            @if (result.ImageUrl is { } cover)
                            {
                                <img class="rcov" src="@cover" alt="" loading="lazy"/>
                            }
                            else
                            {
                                <div class="rcov rcov-none"></div>
                            }
                            <div class="rmeta">
                                <div class="rt2">@result.Title</div>
                                <div class="ra">@UiHelpers.TypeLabel(result.MediaType)</div>
                            </div>
                            @if (result.ReleaseYear is { } year)
                            {
                                <div class="yr">@year</div>
                            }
                        </button>
                    }
                }
                else
                {
                    <p class="muted">Nothing found for “@_query”.</p>
                }
            </div>
        }
    </div>

    @if (_savedMessage is not null)
    {
        <div class="notice good">@_savedMessage</div>
    }
</section>

@* capture modal — click the backdrop to dismiss ── *@
@if (_selected is not null)
{
    <div class="modal-scrim" @onclick="Reset">
        <div class="modal" @onclick:stopPropagation="true">
            @if (_loadingDetail)
            {
                <div class="detail">
                    <div class="dcover"></div>
                    <div class="dm">Fetching details…</div>
                </div>
            }
            else if (_detail is not null)
            {
                <div class="detail">
                    <div class="dcover">
                        @if (!string.IsNullOrWhiteSpace(_detail.ImageUrl))
                        {
                            <img src="@_detail.ImageUrl" alt="Cover of @_detail.Title"/>
                        }
                        else
                        {
                            <div class="fb" style="--tint:@UiHelpers.TypeColorVar(_detail.MediaType)">
                                <span>@_detail.Title</span>
                            </div>
                            <div class="none">No cover</div>
                        }
                    </div>

                    <div>
                        <div class="dt">@_detail.Title</div>
                        <div class="dm">
                            @UiHelpers.TypeLabel(_detail.MediaType)@(_detail.Creator is null ? "" : " · " + _detail.Creator)@(_detail.ReleaseYear is null ? "" : " · " + _detail.ReleaseYear)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_detail.Description))
                        {
                            <div class="dd">@_detail.Description</div>
                        }

                        <div class="dfacts">
                            @if (_detail.Length is { } length)
                            {
                                <div class="dfact">
                                    <div class="n">@length</div>
                                    <div class="l">@UiHelpers.LengthUnit(_detail.MediaType)</div>
                                </div>
                            }
                            @if (_detail.ExternalRating is { } rating)
                            {
                                <div class="dfact">
                                    <div class="n">@rating.ToString("0.0")</div>
                                    <div class="l">@_detail.ExternalSource@(_detail.ExternalRatingCount is { } count ? $" · {count}" : "")</div>
                                </div>
                            }
                            @if (_detail.Genres.Count > 0)
                            {
                                <div class="dfact" style="flex-basis:100%">
                                    <div class="n sm">@string.Join(" · ", _detail.Genres)</div>
                                    <div class="l">Genres per @_detail.ExternalSource</div>
                                </div>
                            }
                            @if (_detail.Tags.Count > 0)
                            {
                                <div class="dfact" style="flex-basis:100%">
                                    <div class="n sm">@string.Join(" · ", _detail.Tags)</div>
                                    <div class="l">Tags per @_detail.ExternalSource</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="capture">
                    <div class="cap-head">
                        <span class="label">Logging</span>
                        <span class="cap-sel">
                            @_detail.Title · @UiHelpers.TypeLabel(_detail.MediaType)@(_detail.Creator is null ? "" : " · " + _detail.Creator)
                        </span>
                    </div>

                    <div class="cap-block">
                        <div class="fl">What are you recording?</div>
                        <div class="segs">
                            @foreach (var action in Enum.GetValues<LogAction>())
                            {
                                <button class="seg @(action == _action ? "on" : "")" @onclick="() => _action = action">
                                    @ActionLabel(action)
                                </button>
                            }
                        </div>
                    </div>

                    <div class="cap-row">
                        <div>
                            <div class="fl">Genres</div>
                            <VocabularyPicker @bind-Selected="_genres" Suggestions="_vocab.Genres"
                                              Placeholder="pick or create…"/>
                        </div>
                    </div>

                    <div class="cap-row">
                        <div>
                            <div class="fl">Tags</div>
                            <VocabularyPicker @bind-Selected="_tags" Suggestions="_vocab.Tags"
                                              Placeholder="pick or create…"/>
                        </div>
                    </div>

                    @if (NewTags.Count > 0)
                    {
                        <div class="cap-block newtags">
                            <div class="fl">
                                New tag@(NewTags.Count == 1 ? "" : "s") — classify once<b>*</b>
                                <span class="opt">picked again later, this is remembered</span>
                            </div>
                            @foreach (var tag in NewTags)
                            {
                                <div class="newtag">
                                    <span class="vp-chip">@tag</span>
                                    <select class="in" value="@FacetOf(tag)"
                                            @onchange="e => SetFacet(tag, e.Value?.ToString())">
                                        <option value="">facet…</option>
                                        @foreach (var facet in Enum.GetValues<TagFacet>())
                                        {
                                            <option value="@facet">@facet</option>
                                        }
                                    </select>
                                    <select class="in" value="@AppliesToOf(tag)"
                                            @onchange="e => SetAppliesTo(tag, e.Value?.ToString())">
                                        <option value="">All media</option>
                                        @foreach (var type in Enum.GetValues<MediaType>())
                                        {
                                            <option value="@type">@UiHelpers.TypeLabel(type) only</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    }

                    <div class="cap-row">
                        <div>
                            <div class="fl">Universe</div>
                            <VocabularyPicker @bind-Selected="_universe" Suggestions="_vocab.Universes"
                                              Max="1" Placeholder="e.g. Cosmere…"/>
                        </div>
                        <div>
                            <div class="fl">Series</div>
                            <VocabularyPicker @bind-Selected="_series" Suggestions="_vocab.Series"
                                              Max="1" Placeholder="e.g. Mistborn Era 1…"/>
                        </div>
                        @if (_series.Count > 0)
                        {
                            <div style="flex:0 0 90px">
                                <div class="fl">Position</div>
                                <input class="in" type="number" min="1" @bind="_seriesPosition"/>
                            </div>
                        }
                    </div>

                    <div class="cap-row">
                        <div>
                            <div class="fl">Discovery</div>
                            <select class="in" @bind="_discovery">
                                <option value="">—</option>
                                @foreach (var source in Enum.GetValues<DiscoverySource>())
                                {
                                    <option value="@source">@UiHelpers.DiscoveryLabel(source)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <div class="fl">Release date</div>
                            <input class="in" type="date" @bind="_releaseDate"/>
                            @if (_detail.ReleaseDate is { } imported && imported != _releaseDate)
                            {
                                <button class="hintbtn" @onclick="() => _releaseDate = imported">
                                    revert to @imported.Year from @_detail.ExternalSource
                                </button>
                            }
                        </div>
                    </div>

                    @if (_action is not LogAction.Interested)
                    {
                        <div class="cap-row">
                            <div>
                                <div class="fl">Start</div>
                                <input class="in" type="date" @bind="_startDate"/>
                            </div>
                            @if (_action is LogAction.Completed)
                            {
                                <div>
                                    <div class="fl">End</div>
                                    <input class="in" type="date" @bind="_endDate"/>
                                </div>
                                @if (IsAudiobook)
                                {
                                    <div>
                                        <div class="fl">Hours listened</div>
                                        <input class="in" type="number" min="0" step="0.1" @bind="_hoursListened"
                                               placeholder="@(_audioHours?.ToString() ?? "")"/>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <div class="fl">Effort (@UiHelpers.LengthUnit(_detail.MediaType))</div>
                                        <input class="in" type="number" min="0" @bind="_effort"
                                               placeholder="@(_detail.Length?.ToString() ?? "")"/>
                                        @if (_detail.Length is { } suggested && _effort != suggested)
                                        {
                                            <button class="hintbtn" @onclick="() => _effort = suggested">
                                                use @suggested @UiHelpers.LengthUnit(_detail.MediaType) from @_detail.ExternalSource
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        <div class="cap-row">
                            <div>
                                <div class="fl">Context</div>
                                <select class="in" @bind="_context">
                                    <option value="">—</option>
                                    @foreach (var context in UiHelpers.ContextsFor(_detail.MediaType))
                                    {
                                        <option value="@context">@UiHelpers.ContextLabel(context)</option>
                                    }
                                </select>
                            </div>
                            @if (IsAudiobook)
                            {
                                <div>
                                    <div class="fl">Audiobook length (hrs)</div>
                                    <input class="in" type="number" min="0" step="0.1" @bind="_audioHours"
                                           placeholder="e.g. 24.5"/>
                                </div>
                            }
                            @if (_action is LogAction.Completed)
                            {
                                <div>
                                    <div class="fl">Rating</div>
                                    <div class="stars">
                                        <span class="track">★★★★★</span>
                                        <span class="fill" style="width:@(_rating * 10)%">★★★★★</span>
                                        @for (var half = 1; half <= 10; half++)
                                        {
                                            var value = half;
                                            <button class="hit" style="left:@((half - 1) * 10)%"
                                                    title="@(value / 2.0)" @onclick="() => _rating = value"></button>
                                        }
                                    </div>
                                    @if (_rating > 0)
                                    {
                                        <button class="starclear" @onclick="() => _rating = 0">clear</button>
                                    }
                                </div>
                            }
                        </div>

                        @if (_action is LogAction.Completed)
                        {
                            <div class="cap-block">
                                <div class="fl">Start note <span class="opt">optional</span></div>
                                <textarea class="area dim" @bind="_startNote" @bind:event="oninput"
                                          placeholder="What you expected going in — leave blank if you don't recall."></textarea>
                            </div>
                        }

                        <div class="cap-block">
                            <div class="fl">
                                @NoteLabel
                                @if (NoteRequired)
                                {
                                    <b>required</b>
                                }
                                else
                                {
                                    <span class="opt">optional</span>
                                }
                            </div>
                            <textarea class="area @(NoteRequired ? "" : "dim")" @bind="_note" @bind:event="oninput"
                                      placeholder="@NotePlaceholder"></textarea>
                        </div>
                    }

                    @if (_error is not null)
                    {
                        <div class="notice bad">@_error</div>
                    }

                    <div class="cap-foot">
                        <span class="req">@FootHint</span>
                        <button class="btn ghost" @onclick="Reset">Cancel</button>
                        <button class="btn" @onclick="Submit" disabled="@(_saving || !CanSubmit)">
                            @(_saving ? "…" : ActionButton(_action))
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* ── RECOMMENDATIONS: skeleton with placeholder rails (not wired up yet) ── *@
<section class="homesec">
    <div class="sechead">
        <span class="label">For you</span>
        <span class="rt">Preview · recommendations aren't wired up yet</span>
    </div>

    @foreach (var rail in RecRails)
    {
        <div class="recrail">
            <div class="recrail-head">
                <span class="recrail-t">@rail.Title</span>
                <span class="recrail-why">@rail.Why</span>
            </div>
            <div class="recrow">
                @foreach (var card in rail.Cards)
                {
                    <div class="reccard">
                        <div class="recposter" style="--tint:@UiHelpers.TypeColorVar(card.Type)">
                            <span>@card.Title</span>
                        </div>
                        <div class="recct">@card.Title</div>
                        <div class="reccc">@card.Creator</div>
                    </div>
                }
                <div class="recmore">soon</div>
            </div>
        </div>
    }
</section>

@code {
    // The three write actions from the vault's Log-and-capture note. Dropped is
    // deliberately absent — you can't drop something you never started.
    private enum LogAction
    {
        Start,
        Completed,
        Interested
    }

    private string _query = "";
    private MediaType _mediaType = MediaType.Book;
    private IReadOnlyList<MediaSearchResultDto> _results = [];
    private bool _searching;
    private bool _searched;

    private MediaSearchResultDto? _selected;
    private MediaItemDto? _detail;
    private bool _loadingDetail;

    private Vocabulary _vocab = new([], [], [], []);

    private LogAction _action = LogAction.Start;
    private List<string> _genres = [];
    private List<string> _tags = [];
    private readonly Dictionary<string, TagInput> _newTags = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _universe = [];
    private List<string> _series = [];
    private int? _seriesPosition;
    private DiscoverySource? _discovery;
    private DateOnly? _releaseDate;
    private DateOnly? _startDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _endDate = DateOnly.FromDateTime(DateTime.Today);
    private int? _effort;
    private double? _audioHours;      // audiobook total length, entered once
    private double? _hoursListened;   // audiobook effort, entered in hours
    private ConsumptionContext? _context;
    private int _rating;
    private string _note = "";
    private string _startNote = "";

    private bool _saving;
    private string? _error;
    private string? _savedMessage;

    protected override Task OnInitializedAsync() => RefreshVocabulary();

    private async Task RefreshVocabulary()
    {
        _vocab = await ImportService.GetVocabularyAsync();
    }

    // A Book consumed as an audiobook: effort is entered in hours, not pages.
    private bool IsAudiobook => _detail?.MediaType == MediaType.Book
                                && _context == ConsumptionContext.Audiobook;

    // Convert audiobook hours to the canonical page unit; fall back to plain effort.
    private int? EffortToStore() =>
        IsAudiobook ? Book.PagesFromHours(_hoursListened, _audioHours, _detail?.Length) : _effort;

    private bool NoteRequired => _action is LogAction.Start;

    private bool CanSubmit =>
        (!NoteRequired || _note.Trim().Length > 0) && NewTags.All(t => FacetOf(t).Length > 0);

    private List<string> NewTags =>
        [.. _tags.Where(t => !_vocab.Tags.Contains(t, StringComparer.OrdinalIgnoreCase))];

    private string FacetOf(string tag) =>
        _newTags.TryGetValue(tag, out var input) && input.Facet is { } facet ? facet.ToString() : "";

    private string AppliesToOf(string tag) =>
        _newTags.TryGetValue(tag, out var input) && input.AppliesTo is { } type ? type.ToString() : "";

    private void SetFacet(string tag, string? value)
    {
        var facet = Enum.TryParse<TagFacet>(value, out var parsed) ? parsed : (TagFacet?)null;
        _newTags[tag] = Existing(tag) with { Facet = facet };
    }

    private void SetAppliesTo(string tag, string? value)
    {
        var type = Enum.TryParse<MediaType>(value, out var parsed) ? parsed : (MediaType?)null;
        _newTags[tag] = Existing(tag) with { AppliesTo = type };
    }

    private TagInput Existing(string tag) =>
        _newTags.TryGetValue(tag, out var input) ? input : new TagInput(tag, null, null);

    private string NoteLabel => _action is LogAction.Start ? "Start note" : "Finish note";

    private string NotePlaceholder => _action switch
    {
        LogAction.Start => "Why you're picking it up, what you expect…",
        _ => "How it landed — this is what the Diary shows."
    };

    private string FootHint => NewTags.Any(t => FacetOf(t).Length == 0)
        ? "Give every new tag a facet — it's only asked once, then it's just a pick."
        : _action switch
        {
            LogAction.Interested => "Goes to the library unstarted. No note needed.",
            LogAction.Start => "A start note is required — this is what the Diary shows.",
            _ => "Backfilling? Rating, genres and moods are what Profile reads. Notes optional."
        };

    private static string ActionLabel(LogAction action) => action switch
    {
        LogAction.Start => "Start a pass",
        LogAction.Completed => "Already finished",
        _ => "Just interested"
    };

    private static string ActionButton(LogAction action) => action switch
    {
        LogAction.Start => "Start it",
        LogAction.Completed => "Log it",
        _ => "Save to library"
    };

    private async Task SetType(MediaType type)
    {
        _mediaType = type;
        if (_searched)
            await RunSearch();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await RunSearch();
    }

    private async Task RunSearch()
    {
        if (_query.Trim().Length == 0)
            return;

        _searching = true;
        _searched = true;
        _error = null;
        _savedMessage = null;

        try
        {
            _results = await Search.SearchAsync(_query.Trim(), _mediaType);
        }
        catch (NotSupportedException)
        {
            _results = [];
            _error = $"No provider is wired up for {UiHelpers.TypeLabel(_mediaType)} yet — books only for now.";
        }
        catch (Exception ex)
        {
            _results = [];
            _error = ex.Message;
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task Select(MediaSearchResultDto result)
    {
        _selected = result;
        _detail = null;
        _loadingDetail = true;
        _error = null;
        _savedMessage = null;

        try
        {
            _detail = await Search.GetByIdAsync(result.ExternalId, result.MediaType);
            _effort = _detail?.Length;
            _releaseDate = _detail?.ReleaseDate;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingDetail = false;
        }
    }

    private async Task Submit()
    {
        if (_detail is null)
            return;

        _saving = true;
        _error = null;

        var item = _detail with { ReleaseDate = _releaseDate };

        var details = new WorkDetails(
            _genres,
            [.. _tags.Select(Existing)],
            _universe.FirstOrDefault(),
            _series.FirstOrDefault(),
            _seriesPosition,
            _discovery,
            IsAudiobook ? _audioHours : null);

        var note = _note.Trim().Length == 0 ? null : _note.Trim();
        var startNote = _startNote.Trim().Length == 0 ? null : _startNote.Trim();

        var start = new PassStart(_startDate, _context,
            _action is LogAction.Start ? note : startNote);

        try
        {
            switch (_action)
            {
                case LogAction.Interested:
                    await ImportService.AddItemAsync(item, details);
                    break;

                case LogAction.Start:
                    var userMediaItemId = await ImportService.AddItemAsync(item, details);
                    await LogService.StartPassAsync(userMediaItemId, start);
                    break;

                default:
                    var finish = new PassFinish(
                        _endDate ?? DateOnly.FromDateTime(DateTime.Today),
                        _rating == 0 ? null : _rating,
                        EffortToStore(),
                        note);
                    await LogService.LogCompletedAsync(item, details, start, finish);
                    break;
            }

            _savedMessage = $"“{_detail.Title}” — {ActionLabel(_action).ToLowerInvariant()}.";
            await RefreshVocabulary();
            Reset();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // Clears the current selection and the capture form; leaves the results in place.
    private void Reset()
    {
        _selected = null;
        _detail = null;
        _action = LogAction.Start;
        _genres = [];
        _tags = [];
        _newTags.Clear();
        _universe = [];
        _series = [];
        _seriesPosition = null;
        _discovery = null;
        _releaseDate = null;
        _startDate = DateOnly.FromDateTime(DateTime.Today);
        _endDate = DateOnly.FromDateTime(DateTime.Today);
        _effort = null;
        _audioHours = null;
        _hoursListened = null;
        _context = null;
        _rating = 0;
        _note = "";
        _startNote = "";
    }

    // ── Recommendations skeleton — static placeholders until the engine exists ──
    private record RecCard(string Title, string Creator, MediaType Type);
    private record RecRail(string Title, string Why, List<RecCard> Cards);

    private static readonly List<RecRail> RecRails =
    [
        new("More from Brandon Sanderson", "You rate his books highly",
        [
            new("Warbreaker", "Brandon Sanderson", MediaType.Book),
            new("Elantris", "Brandon Sanderson", MediaType.Book),
            new("Tress of the Emerald Sea", "Brandon Sanderson", MediaType.Book),
            new("The Sunlit Man", "Brandon Sanderson", MediaType.Book)
        ]),
        new("More from FromSoftware", "Because you played Elden Ring",
        [
            new("Sekiro", "FromSoftware", MediaType.Game),
            new("Bloodborne", "FromSoftware", MediaType.Game),
            new("Dark Souls III", "FromSoftware", MediaType.Game),
            new("Armored Core VI", "FromSoftware", MediaType.Game)
        ]),
        new("Popular in your genres", "Top-rated in fantasy & sci-fi",
        [
            new("Dune", "Frank Herbert", MediaType.Book),
            new("Blade Runner 2049", "Denis Villeneuve", MediaType.Movie),
            new("Disco Elysium", "ZA/UM", MediaType.Game),
            new("Severance", "Dan Erickson", MediaType.Show)
        ]),
        new("Cross-domain picks", "Reads like the things you love, across media",
        [
            new("Hyperion", "Dan Simmons", MediaType.Book),
            new("Outer Wilds", "Mobius Digital", MediaType.Game),
            new("Arrival", "Denis Villeneuve", MediaType.Movie)
        ]),
        new("Claude's picks", "From your profile & taste",
        [
            new("Piranesi", "Susanna Clarke", MediaType.Book),
            new("Pentiment", "Obsidian", MediaType.Game),
            new("The Leftovers", "Damon Lindelof", MediaType.Show)
        ])
    ];
}
