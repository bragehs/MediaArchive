@page "/profile"
@using System.Globalization
@using MediaArchive.Services.Queries
@inject ProfileQueries Stats
@inject NavigationManager Nav

<PageTitle>Profile · MediaArchive</PageTitle>

@if (_snapshot is null)
{
    <p class="pempty">Loading…</p>
}
else if (_snapshot.ItemsLogged == 0)
{
    <p class="pempty">Nothing logged yet — the profile fills in as you add things.</p>
}
else
{
    <div class="pstrip">
        <div class="pcell">
            <div class="pnum">@_snapshot.ItemsLogged</div>
            <div class="plab">Items logged</div>
        </div>
        <div class="pcell">
            @if (_snapshot.AvgRating is { } avg)
            {
                <div class="pnum">@Stars(avg)<i>/5</i></div>
                <div class="plab">Avg rating</div>
                <div class="pnote">across @_snapshot.RatedCount rated</div>
            }
            else
            {
                <div class="pnum pnone">—</div>
                <div class="plab">Avg rating</div>
                <div class="pnote">nothing rated yet</div>
            }
        </div>
        <div class="pcell">
            <div class="pnum">@_snapshot.Finished</div>
            <div class="plab">Finished</div>
            <div class="pnote">of @_snapshot.ItemsLogged logged</div>
        </div>
        <div class="pcell">
            <div class="pnum">@_snapshot.GenreCount</div>
            <div class="plab">Genres</div>
        </div>
    </div>

    @if (_snapshot.HallOfFame.Count > 0)
    {
        <div class="psec"><span class="psk">Hall of fame</span></div>
        <div class="pfamerail">
            @foreach (var fame in _snapshot.HallOfFame)
            {
                <button class="pfame" @onclick="() => Open(fame.UserMediaItemId)">
                    <span class="pfcov">
                        @if (!string.IsNullOrWhiteSpace(fame.ImageUrl))
                        {
                            <img src="@fame.ImageUrl" alt="Cover of @fame.Title"/>
                        }
                        else
                        {
                            <span class="pffb">@fame.Title</span>
                        }
                        <span class="pfbadge">@(fame.IsFavorite ? "♥" : $"★ {Stars(fame.Rating)}")</span>
                    </span>
                </button>
            }
        </div>
    }

    @foreach (var universe in _snapshot.Universes)
    {
        <div class="psec">
            <span class="psk">@universe.Name</span>
            <span class="psr">
                @universe.Works works@(universe.AvgRating is { } stars ? $" · ★ {Stars(stars)}" : "")
            </span>
        </div>
        <p class="puefx">
            @string.Join(" · ", universe.Effort.Select(e => $"{Trim(e.Value)} {e.Unit}"))
        </p>
        <div class="purail">
            @foreach (var cover in universe.Covers)
            {
                <button class="pucov" @onclick="() => Open(cover.UserMediaItemId)">
                    @if (!string.IsNullOrWhiteSpace(cover.ImageUrl))
                    {
                        <img src="@cover.ImageUrl" alt="Cover of @cover.Title"/>
                    }
                    else
                    {
                        <span class="pufb">@cover.Title</span>
                    }
                    <span class="pugl st-@(cover.Status.ToString().ToLowerInvariant())" title="@UiHelpers.StatusLabel(cover.Status)">@UiHelpers.StatusGlyph(cover.Status)</span>
                </button>
            }
        </div>
    }

    @if (_snapshot.Canon.Count > 0)
    {
        <div class="psec"><span class="psk">The canon</span></div>
        <div class="pcanon">
            @foreach (var creator in _snapshot.Canon)
            {
                <div class="pcreator">
                    <span class="pcn">@creator.Name</span>
                    <span class="pcw">
                        <b>@creator.Works</b> @(creator.Works == 1 ? "work" : "works")
                        · @string.Join(" · ", creator.Types.Select(t => UiHelpers.TypeLabel(t).ToLowerInvariant() + (creator.Works == 1 ? "" : "s")))
                    </span>
                    @if (creator.AvgRating is { } stars)
                    {
                        <span class="pcs">★ @Stars(stars)</span>
                    }
                </div>
            }
        </div>
    }

    <div class="psec"><span class="psk">Records</span></div>

    @if (_snapshot.Panels.Count > 0)
    {
        <div class="prtabs">
            @foreach (var panel in _snapshot.Panels)
            {
                <button class="prtab @(panel.MediaType == _recordsTab ? "on" : "")"
                        @onclick="() => _recordsTab = panel.MediaType">
                    @UiHelpers.TypeLabel(panel.MediaType)s
                </button>
            }
        </div>

        @if (Current is { } current)
        {
            @if (current.Stats.Count > 0)
            {
                <div class="prstats">
                    @foreach (var stat in current.Stats)
                    {
                        <div class="prstat">
                            <div class="prsv">@stat.Value</div>
                            <div class="prsl">@stat.Label</div>
                        </div>
                    }
                </div>
            }

            @if (current.Weekly.Any(w => w.Value > 0) || current.Yearly.Any(y => y.Value > 0))
            {
                <div class="prscope">
                    <button class="prsc @(!_allTime ? "on" : "")" @onclick="() => _allTime = false">@DateTime.Today.Year</button>
                    <button class="prsc @(_allTime ? "on" : "")" @onclick="() => _allTime = true">All time</button>
                </div>

                @if (!_allTime)
                {
                    var max = Math.Max(1, current.Weekly.Max(w => w.Value));
                    <div class="prchart">
                        @foreach (var week in current.Weekly)
                        {
                            <div class="prwk" title="week of @week.WeekStart.ToString("d MMM") · @Trim(week.Value) @current.Unit">
                                <i style="height:@(Pct(week.Value, max))"></i>
                                @if (week.WeekStart.Day <= 7)
                                {
                                    <span class="prwm">@week.WeekStart.ToString("MMM")[0]</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="prchl">@current.Unit / week · @DateTime.Today.Year</div>
                }
                else
                {
                    var max = Math.Max(1, current.Yearly.Max(y => y.Value));
                    var step = Math.Max(1, (int)Math.Ceiling(current.Yearly.Count / 8.0));
                    <div class="prchart">
                        @foreach (var year in current.Yearly)
                        {
                            <div class="prwk" title="@year.Year · @Trim(year.Value) @current.Unit">
                                <i style="height:@(Pct(year.Value, max))"></i>
                                @if ((year.Year - current.Yearly[0].Year) % step == 0)
                                {
                                    <span class="prwm">@year.Year.ToString()[2..]</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="prchl">@current.Unit / year · all time</div>
                }
            }

            <div class="precs">
                @foreach (var record in current.Records)
                {
                    <button class="prec" @onclick="() => Open(record.UserMediaItemId)">
                        <span class="prl">@record.Label</span>
                        <span class="prv">@record.Value</span>
                        <span class="prt">@record.Title</span>
                    </button>
                }
                @if (_snapshot.BusiestMonth is { } busiest)
                {
                    <div class="prec">
                        <span class="prl">Busiest month</span>
                        <span class="prv">@busiest.Logs logs</span>
                        <span class="prt">@MonthName(busiest.Month) @busiest.Year · everything</span>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private ProfileSnapshot? _snapshot;
    private MediaType _recordsTab = MediaType.Book;
    private bool _allTime;

    private TypePanel? Current =>
        _snapshot?.Panels.FirstOrDefault(p => p.MediaType == _recordsTab)
        ?? _snapshot?.Panels.FirstOrDefault();

    protected override async Task OnInitializedAsync() =>
        _snapshot = await Stats.GetSnapshotAsync();

    private void Open(int userMediaItemId) => Nav.NavigateTo($"/item/{userMediaItemId}");

    // Ratings live on /10 in the model; the app speaks stars.
    private static string Stars(double tenScale) =>
        (tenScale / 2).ToString("0.#", CultureInfo.InvariantCulture);

    private static string Trim(double value) =>
        value.ToString("#,0.#", CultureInfo.InvariantCulture);

    private static string Pct(double value, double max) =>
        (max <= 0 ? 0 : value / max * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string MonthName(int month) =>
        CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month);
}
