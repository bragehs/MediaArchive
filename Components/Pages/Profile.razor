@page "/profile"
@using System.Globalization
@using MediaArchive.Services.Queries
@inject ProfileQueries Stats
@inject NavigationManager Nav

<PageTitle>Profile · MediaArchive</PageTitle>

@if (_snapshot is null)
{
    <p class="pempty">Loading…</p>
}
else if (_snapshot.ItemsLogged == 0)
{
    <p class="pempty">Nothing logged yet — the profile fills in as you add things.</p>
}
else
{
    <div class="pstrip">
        <div class="pcell">
            <div class="pnum">@_snapshot.ItemsLogged</div>
            <div class="plab">Items logged</div>
        </div>
        <div class="pcell">
            @if (_snapshot.AvgRating is { } avg)
            {
                <div class="pnum">@Stars(avg)<i>/5</i></div>
                <div class="plab">Avg rating</div>
                <div class="pnote">across @_snapshot.RatedCount rated</div>
            }
            else
            {
                <div class="pnum pnone">—</div>
                <div class="plab">Avg rating</div>
                <div class="pnote">nothing rated yet</div>
            }
        </div>
        <div class="pcell">
            <div class="pnum">@_snapshot.Finished</div>
            <div class="plab">Finished</div>
            <div class="pnote">of @_snapshot.ItemsLogged logged</div>
        </div>
        <div class="pcell">
            <div class="pnum">@_snapshot.GenreCount</div>
            <div class="plab">Genres</div>
        </div>
    </div>

    @if (_snapshot.HallOfFame.Count > 0)
    {
        <div class="psec"><span class="psk">Hall of fame</span><span class="psr">The keepers</span></div>
        <div class="pfamerail">
            @foreach (var fame in _snapshot.HallOfFame)
            {
                <button class="pfame" @onclick="() => Open(fame.UserMediaItemId)">
                    <span class="pfcov">
                        @if (!string.IsNullOrWhiteSpace(fame.ImageUrl))
                        {
                            <img src="@fame.ImageUrl" alt="Cover of @fame.Title"/>
                        }
                        else
                        {
                            <span class="pffb">@fame.Title</span>
                        }
                        <span class="pfbadge">@(fame.IsFavorite ? "♥" : $"★ {Stars(fame.Rating)}")</span>
                    </span>
                </button>
            }
        </div>
    }

    @if (_snapshot.Verdicts.Count > 0)
    {
        <div class="psec"><span class="psk">Against the grain</span><span class="psr">You vs the world</span></div>
        <div class="pverdicts">
            @foreach (var v in _snapshot.Verdicts)
            {
                <button class="pverdict" @onclick="() => Open(v.UserMediaItemId)">
                    <span class="pvt">@v.Title</span>
                    <span class="pvn">you <b>@Stars(v.Mine)</b> · them <b>@Stars(v.World)</b></span>
                    <span class="pvd @DeltaClass(v.Delta)">@Signed(v.Delta)</span>
                </button>
            }
        </div>
        @if (_snapshot.AvgDelta is { } avgDelta)
        {
            <p class="pfoot">
                @if (Math.Round(avgDelta / 2, 1) == 0)
                {
                    <text>On average you land <b>dead level</b> with the public.</text>
                }
                else
                {
                    <text>On average you land <b>@Signed(avgDelta)</b> @(avgDelta >= 0 ? "above" : "below") the public.</text>
                }
            </p>
        }
    }

    @if (_snapshot.Canon.Count > 0)
    {
        <div class="psec"><span class="psk">The canon</span><span class="psr">Creators you return to</span></div>
        <div class="pcanon">
            @foreach (var creator in _snapshot.Canon)
            {
                <div class="pcreator">
                    <span class="pcn">@creator.Name</span>
                    <span class="pcw">
                        <b>@creator.Works</b> @(creator.Works == 1 ? "work" : "works")
                        · @string.Join(" · ", creator.Types.Select(t => UiHelpers.TypeLabel(t).ToLowerInvariant() + (creator.Works == 1 ? "" : "s")))
                    </span>
                    @if (creator.AvgRating is { } stars)
                    {
                        <span class="pcs">★ @Stars(stars)</span>
                    }
                </div>
            }
        </div>
    }

    <div class="psec"><span class="psk">Records</span><span class="psr">The extremes</span></div>
    <div class="precs">
        @if (_snapshot.LongestPass is { } longest)
        {
            <button class="prec" @onclick="() => Open(longest.UserMediaItemId)">
                <span class="prl">Longest pass</span>
                <span class="prv">@Days(longest.Days)</span>
                <span class="prt">@longest.Title</span>
            </button>
        }
        @if (_snapshot.FastestFinish is { } fastest)
        {
            <button class="prec" @onclick="() => Open(fastest.UserMediaItemId)">
                <span class="prl">Fastest finish</span>
                <span class="prv">@Days(fastest.Days)</span>
                <span class="prt">@fastest.Title</span>
            </button>
        }
        @if (_snapshot.DeepestBail is { } bail)
        {
            <button class="prec" @onclick="() => Open(bail.UserMediaItemId)">
                <span class="prl">Deepest bail</span>
                <span class="prv">@bail.Share.ToString("P0", CultureInfo.InvariantCulture) in</span>
                <span class="prt">@bail.Title</span>
            </button>
        }
        @if (_snapshot.BusiestMonth is { } busiest)
        {
            <div class="prec">
                <span class="prl">Busiest month</span>
                <span class="prv">@busiest.Logs logs</span>
                <span class="prt">@MonthName(busiest.Month) @busiest.Year</span>
            </div>
        }
    </div>
}

@code {
    private ProfileSnapshot? _snapshot;

    protected override async Task OnInitializedAsync() =>
        _snapshot = await Stats.GetSnapshotAsync();

    private void Open(int userMediaItemId) => Nav.NavigateTo($"/item/{userMediaItemId}");

    // Ratings live on /10 in the model; the app speaks stars.
    private static string Stars(double tenScale) =>
        (tenScale / 2).ToString("0.#", CultureInfo.InvariantCulture);

    // Rounded to display precision first, so a hair's-width disagreement can't
    // render as the nonsense "−0.0".
    private static string Signed(double tenScaleDelta)
    {
        var stars = Math.Round(tenScaleDelta / 2, 1);
        if (stars == 0) return "0.0";
        return (stars > 0 ? "+" : "−") +
               Math.Abs(stars).ToString("0.0", CultureInfo.InvariantCulture);
    }

    private static string DeltaClass(double tenScaleDelta) =>
        Math.Round(tenScaleDelta / 2, 1) switch
        {
            0 => "level",
            > 0 => "up",
            _ => "down"
        };

    private static string Days(int days) => days switch
    {
        0 => "same day",
        1 => "1 day",
        _ => $"{days} days"
    };

    private static string MonthName(int month) =>
        CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month);
}
