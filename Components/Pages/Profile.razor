@page "/profile"
@inject LibraryService Library

<PageTitle>Profile · MediaArchive</PageTitle>

<div class="page-head">
    <h1>Taste profile</h1>
    <p>Who am I, media-wise? Aggregates over everything, across every type.</p>
</div>

@if (_stats is null)
{
    <div class="empty">Loading…</div>
}
else
{
    <div class="stat-grid">
        <div class="stat"><div class="n">@_stats.TotalItems</div><div class="l">Items tracked</div></div>
        <div class="stat"><div class="n accent">@_stats.Completed</div><div class="l">Completed</div></div>
        <div class="stat"><div class="n">@_stats.InProgress</div><div class="l">In progress</div></div>
        <div class="stat"><div class="n gold">★ @_stats.AverageRating</div><div class="l">Average rating</div></div>
        <div class="stat"><div class="n fav" style="color:var(--show)">♥ @_stats.Favorites</div><div class="l">Favourites</div></div>
    </div>

    <div class="section-title">By media type</div>
    <div class="panel">
        @foreach (var t in _typeOrder)
        {
            var c = _stats.CountByType.GetValueOrDefault(t);
            <div class="bar-row">
                <span class="lbl">
                    <span class="dot" style="background:@UiHelpers.TypeColorVar(t)"></span>
                    @UiHelpers.TypeLabel(t)
                </span>
                <span class="bar-track"><span class="bar-fill" style="width:@Pct(c)%"></span></span>
                <span class="val">@c</span>
            </div>
        }
    </div>

    <div class="section-title">Top genres</div>
    <div class="filter-row">
        @foreach (var g in _stats.TopGenres)
        {
            <span class="chip">@g.Name <span class="count">@g.Count</span></span>
        }
    </div>

    <div class="section-title">Highest rated</div>
    <div class="wall small">
        @foreach (var umi in _stats.HighestRated)
        {
            <MediaCard Umi="umi" />
        }
    </div>

    <div class="note-banner" style="margin-top:30px">
        📊 Cross-media taste insights &amp; recommendations (the payoff of the pivot) build on
        top of these aggregates in later phases.
    </div>
}

@code {
    private ProfileStats? _stats;

    private readonly MediaType[] _typeOrder =
        [MediaType.Book, MediaType.Game, MediaType.Movie, MediaType.Show, MediaType.Anime];

    protected override async Task OnInitializedAsync() => _stats = await Library.GetProfileAsync();

    private int Pct(int count)
    {
        var max = _stats!.CountByType.Values.DefaultIfEmpty(0).Max();
        return max == 0 ? 0 : (int)Math.Round(100.0 * count / max);
    }
}
