@page "/diary"
@inject LibraryService Library

<PageTitle>Diary · MediaArchive</PageTitle>

<div class="page-head">
    <h1>Diary</h1>
    <p>A chronological feed of every pass — reads, plays, watches — newest first.</p>
</div>

@if (_entries is null)
{
    <div class="empty">Loading…</div>
}
else if (_entries.Count == 0)
{
    <div class="empty">No consumption entries yet.</div>
}
else
{
    <div class="timeline">
        @foreach (var e in _entries)
        {
            var item = e.UserMediaItem!.MediaItem!;
            <div class="tl-entry">
                <div class="tl-date">@FormatDate(e.EndDate ?? e.StartDate)</div>
                <a class="tl-thumb" href="item/@item.Id"><CoverArt Item="item" /></a>
                <div class="tl-body">
                    <div><strong>@item.Title</strong>
                        <span class="card-sub"> · @UiHelpers.TypeLabel(item.MediaType)</span>
                    </div>
                    <div class="card-sub">
                        @if (e.RatingAtTime is { } r) { <span class="badge-glyph rating">★ @r</span> }
                        @if (e.Effort is { } eff) { <span> · @eff @EffortUnit(item.MediaType)</span> }
                        @Range(e)
                    </div>
                    @if (!string.IsNullOrWhiteSpace(e.Notes))
                    {
                        <div class="notes" style="margin-top:5px">“@e.Notes”</div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ConsumptionEntry>? _entries;

    protected override async Task OnInitializedAsync() => _entries = await Library.GetDiaryAsync();

    private static string FormatDate(DateOnly? d) => d?.ToString("MMM d, yyyy") ?? "—";

    private static string Range(ConsumptionEntry e) =>
        e.StartDate is { } s && e.EndDate is { } en && s != en
            ? $" · {s:MMM d}–{en:MMM d}"
            : "";

    private static string EffortUnit(MediaType t) => t switch
    {
        MediaType.Book => "pages",
        MediaType.Game => "hours",
        MediaType.Anime or MediaType.Show => "episodes",
        _ => "min"
    };
}
