@page "/"
@inject LibraryService Library

<PageTitle>Home · MediaArchive</PageTitle>

<div class="page-head">
    <h1>Welcome back</h1>
    <p>Everything you're consuming, in one place.</p>
</div>

<div class="quick-log">
    <input placeholder="Quick-log anything — search books, games, films, shows, anime…" disabled />
    <button class="btn" disabled>Log</button>
</div>
<div style="height:26px"></div>

@if (_current is null)
{
    <div class="empty">Loading…</div>
}
else
{
    <div class="section-title">Currently consuming</div>
    @if (_current.Count == 0)
    {
        <div class="empty">Nothing in progress right now.</div>
    }
    else
    {
        <div class="row-scroll">
            @foreach (var umi in _current)
            {
                <MediaCard Umi="umi" />
            }
        </div>
    }

    <div class="section-title">Recent activity</div>
    <div class="panel">
        @foreach (var e in _recent!)
        {
            <div class="entry-card">
                <div class="when">
                    <strong>@e.UserMediaItem!.MediaItem!.Title</strong>
                    <div class="notes">
                        @UiHelpers.TypeLabel(e.UserMediaItem.MediaItem.MediaType)
                        @(e.RatingAtTime is { } r ? $"· rated ★ {r}" : "")
                    </div>
                </div>
                <span class="tl-date">@FormatDate(e.EndDate ?? e.StartDate)</span>
            </div>
        }
    </div>

    <div class="section-title">Lore fact of the day</div>
    <div class="note-banner">
        🐉 <strong>Middle-earth</strong> — the AI-generated lore widget lands in a later phase
        (Claude API service). This is a placeholder for the Home surface.
    </div>
}

@code {
    private List<UserMediaItem>? _current;
    private List<ConsumptionEntry>? _recent;

    protected override async Task OnInitializedAsync()
    {
        _current = await Library.GetCurrentlyConsumingAsync();
        _recent = await Library.GetDiaryAsync(6);
    }

    private static string FormatDate(DateOnly? d) => d?.ToString("MMM d, yyyy") ?? "—";
}
