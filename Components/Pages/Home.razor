@page "/"
@using MediaArchive.Services
@inject CommonQueries Common
@inject HomeQueries Dashboard
@inject NavigationManager Nav

<PageTitle>Home · MediaArchive</PageTitle>

@if (_loading)
{
    <p class="mempty">Loading…</p>
}
else
{
    @if (_weekly is { } week)
    {
        <div class="mweek">
            <span class="mwdate">This week</span>
            @foreach (var b in week.Buckets)
            {
                <div class="mwcell">
                    <div class="mwnum">@FormatValue(b)<i>@UnitShort(b.Unit)</i></div>
                    <div class="mwlab">@b.Bucket</div>
                    <div class="mwitems">@b.ItemsTouched @Plural(b.ItemsTouched, "item")</div>
                </div>
            }
        </div>
    }

    <div class="msec"><span class="mk">Open now</span><span class="mr">@_openNow.Count open</span></div>
    @if (_openNow.Count == 0)
    {
        <p class="mempty">Nothing in progress right now.</p>
    }
    else
    {
        @foreach (var item in _openNow)
        {
            <div class="mnow">
                <div class="mcov mnowcov" style="--t:@UiHelpers.TypeColorVar(item.MediaType)"
                     @onclick="() => OpenItem(item.UserMediaItemId)">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="Cover of @item.Title"/>
                    }
                    else
                    {
                        <span class="mfb">@item.Title</span>
                    }
                </div>
                <div class="mnowbody">
                    <div class="mnowt" @onclick="() => OpenItem(item.UserMediaItemId)">@item.Title</div>
                    <div class="mnowmeta">touched @Ago(item.DaysSinceTouched)@(item.Progress is { } p ? $" · {p:0}%" : "")</div>
                    @if (item.Progress is { } pct)
                    {
                        <div class="mbar"><i style="width:@(pct.ToString("0"))%"></i></div>
                    }
                    <div class="mnowfoot">
                        open <b>@item.DaysOpen</b> @Plural(item.DaysOpen, "day")
                        <button class="mlog" @onclick="() => _logTarget = item">Log →</button>
                    </div>
                </div>
            </div>
        }
    }

    <div class="msec"><span class="mk">On deck</span><span class="mr">What's next</span></div>
    @if (_onDeck.Count == 0)
    {
        <p class="mempty">Nothing lined up.</p>
    }
    else
    {
        <div class="mrail">
            @foreach (var item in _onDeck.Take(OnDeckCap))
            {
                <div class="mcov" @onclick="() => OpenItem(item.UserMediaItemId)">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="Cover of @item.Title"/>
                    }
                    else
                    {
                        <span class="mfb">@item.Title</span>
                    }
                </div>
            }
            @if (_onDeck.Count > OnDeckCap)
            {
                <div class="mmore">+@(_onDeck.Count - OnDeckCap)</div>
            }
        </div>
    }

    @if (_justClosed is { } jc)
    {
        <div class="mclosed">
            <span class="mct" @onclick="() => OpenItem(jc.UserMediaItemId)">@jc.Title</span>
            @if (jc.Rating is { } r)
            {
                <span class="mstars"><span class="mstrack">★★★★★</span><span class="msfill" style="width:@(r * 10)%">★★★★★</span></span>
            }
            <span class="mcmeta">@jc.Creator · closed @Ago(jc.DaysSinceClosed)</span>
        </div>
    }
}

@if (_logTarget is { } target)
{
    <LogProgressDialog EntryId="@target.OpenEntryId" Title="@target.Title" MediaType="@target.MediaType"
                       Audiobook="@target.IsAudiobook" AudioHours="@target.AudioHours" PageCount="@target.PageCount"
                       OnClose="() => _logTarget = null" OnLogged="OnLogged"/>
}

@code {
    private const int OnDeckCap = 8;

    private bool _loading = true;
    private IReadOnlyList<CoverCard> _onDeck = [];
    private IReadOnlyList<OpenNowItem> _openNow = [];
    private JustClosedItem? _justClosed;
    private WeeklyActivity? _weekly;
    private OpenNowItem? _logTarget;

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OpenItem(int userMediaItemId) => Nav.NavigateTo($"/item/{userMediaItemId}");

    private async Task LoadAsync()
    {
        _onDeck = await Common.GetBacklogAsync();
        _openNow = await Dashboard.GetOpenNowAsync();
        _justClosed = await Dashboard.GetJustClosedAsync();
        _weekly = await Dashboard.GetWeeklyActivityAsync();
        _loading = false;
    }

    private async Task OnLogged()
    {
        _logTarget = null;
        await LoadAsync();
    }

    private static string Ago(int days) =>
        days <= 0 ? "today" : days == 1 ? "yesterday" : $"{days} days ago";

    private static string Plural(int n, string word) => n == 1 ? word : word + "s";

    private static string FormatValue(WeeklyBucketStat b) =>
        b.Unit == "pages" ? ((int)b.Value).ToString() : b.Value.ToString("0.#");

    private static string UnitShort(string unit) => unit switch
    {
        "pages" => "P",
        "hours" => "H",
        "minutes" => "M",
        _ => unit.Length > 0 ? char.ToUpperInvariant(unit[0]).ToString() : ""
    };
}
