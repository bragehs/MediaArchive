@inherits LayoutComponentBase
@using MediaArchive.Services.Infrastructure
@inject NavigationManager Nav
@inject DeepLinkService DeepLinks

<div class="shell">
    <header class="appbar">
        <div class="brand">
            <img class="brandmark" src="_content/MediaArchive/brandmark.png" alt=""/>Media<b>Archive</b>
        </div>
    </header>

    <main class="viewport">
        @Body
    </main>

    <nav class="tabbar">
        <NavLink class="tab" href="" Match="NavLinkMatch.All"><span class="ti">◈</span>Home</NavLink>
        <NavLink class="tab" href="explore"><span class="ti">⌕</span>Explore</NavLink>
        <NavLink class="tab" href="library"><span class="ti">▦</span>Library</NavLink>
        <NavLink class="tab" href="diary"><span class="ti">❯</span>Diary</NavLink>
        <NavLink class="tab" href="profile"><span class="ti">◉</span>Profile</NavLink>
    </nav>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // The layout lives for the whole app session, which makes it the natural
    // subscriber for native deep links. Routes dispatched before first render
    // (cold start from a widget tap) are queued inside the service and
    // delivered on Subscribe.
    protected override void OnInitialized() =>
        DeepLinks.Subscribe(route => _ = InvokeAsync(() => Nav.NavigateTo(route)));
}
