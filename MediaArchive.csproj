<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MediaArchive</RootNamespace>
  </PropertyGroup>

  <!-- Global usings the providers and services lean on. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- The test, mobile-head, generator and Swift trees live under this project's
       folder; keep default globbing from compiling their files into the library.
       `http/` and `backups/` are local scratch, and must not ride along into the app bundle. -->
  <ItemGroup>
    <Compile Remove="Tests/**;MediaArchive.Mobile/**;tools/**;native/**;http/**;backups/**" />
    <Content Remove="Tests/**;MediaArchive.Mobile/**;tools/**;native/**;http/**;backups/**" />
    <None Remove="Tests/**;MediaArchive.Mobile/**;tools/**;native/**;http/**;backups/**" />
    <EmbeddedResource Remove="Tests/**;MediaArchive.Mobile/**;tools/**;native/**;http/**;backups/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
